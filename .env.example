# Application Configuration
NODE_ENV=development
APP_NAME=Pentester AI
APP_URL=http://localhost:5173
PORT=3001

# Database Configuration
MONGODB_URI=mongodb://127.0.0.1:27017/pentester_ai
MONGODB_DB_NAME=pentester_ai

# Primary AI Provider (gemini)
AI_PROVIDER=gemini

# Google Gemini API
# Get your API key at: https://aistudio.google.com/
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# Security & Data Encryption (32-character hex key for encrypting stored API keys)
ENCRYPTION_KEY=e4d2a1b9c8e7f6a5b4c3d2e1f0a9b8c7e6d5c4b3a2f1e0d9c8b7a6f5e4d3c2b1

# Scanner Configuration
SCANNER_ENABLED=true
SCAN_TIMEOUT=1800
MAX_CONCURRENT_SCANS=2
